# ----------------------------
# TRACE
# ----------------------------
KAKAO_TRACE=1

# ----------------------------
# Kakao OAuth login
# ----------------------------
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=http://localhost:8765/auth/kakao/callback
KAKAO_CLIENT_SECRET=
KAKAO_LOGIN_PROMPT=login
AUTH_MODE=no_db
AUTH_PROVIDER=kakao
AUTH_PERSIST_SESSION=false

# ----------------------------
# Beta emergency login
# ----------------------------
BETA_PASSWORD_LOGIN_ENABLED=true
BETA_LOGIN_ID=test
BETA_LOGIN_PASSWORD_HASH=
BETA_LOGIN_PASSWORD_SALT=

# ----------------------------
# Error report on/off
# ----------------------------
KCS_ERROR_REPORT_ENABLED=1

# ----------------------------
# Mail target
# ----------------------------
KCS_ERROR_REPORT_TO=idblackcat@gmail.com
KCS_ERROR_REPORT_FROM=your_sender@gmail.com

# ----------------------------
# SMTP
# Gmail App Password 사용
# 일반 비밀번호 사용 금지
# ----------------------------
KCS_ERROR_REPORT_SMTP_HOST=smtp.gmail.com
KCS_ERROR_REPORT_SMTP_PORT=587
KCS_ERROR_REPORT_SMTP_USER=your_sender@gmail.com
KCS_ERROR_REPORT_SMTP_PASS=your_gmail_app_password

# ----------------------------
# Subject / throttling
# ----------------------------
KCS_ERROR_REPORT_SUBJECT_PREFIX=[KCS][ERROR][TEST]
KCS_ERROR_REPORT_MAX_PER_RUN=5
KCS_ERROR_REPORT_COOLDOWN_SEC=60

# ----------------------------
# Kasender Auth API
# ----------------------------
AUTH_API_MODE=production
AUTH_API_BASE_URL=https://auth.kasender.com
AUTH_API_BASE_URL_LOCAL=http://127.0.0.1:8787
AUTH_API_BASE_URL_PRODUCTION=https://auth.kasender.com
AUTH_API_TIMEOUT_SEC=10
PROJECT_CODE=kasender

# Optional local-only override for Auth API decision testing.
# Applied only when AUTH_API_BASE_URL/effective URL is localhost.
AUTH_API_DEV_PROVIDER_USER_ID_OVERRIDE=
KASENDER_DEV_KAKAO_PROVIDER_USER_ID=
